# Local only. `wrangler pages dev` reads .dev.vars. Do not commit that file.
# The values below are Cloudflare's published Turnstile test pair. They always
# pass, and the API rejects this secret on any host other than localhost.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=replace-with-a-long-random-string
# Optional. Required only for POST /api/review.
# ADMIN_REVIEW_TOKEN=
