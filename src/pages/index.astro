---
import Base from "../layouts/Base.astro";
---

<Base
  title="Every Share Votes"
  description="A self-reported, share-weighted tally of TSLA holders on a possible combination with SpaceX. Not an official vote."
>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Independent · self-reported · not a proxy</p>
      <h1>Where holders stand on a combination.</h1>
      <p class="lede">A live tally of TSLA shares their owners say are for or against a possible combination with SpaceX.</p>
      <div class="actions">
        <a class="button" href="/add-shares/">Add my shares</a>
        <a class="button secondary" href="/the-vote/">What a real vote would mean</a>
      </div>
    </section>

    <section class="scoreboard" aria-label="Share-weighted tally">
      <article class="score for">
        <p class="kicker">For</p>
        <strong id="for-shares">—</strong>
        <span>shares</span>
      </article>
      <article class="score against">
        <p class="kicker">Against</p>
        <strong id="against-shares">—</strong>
        <span>shares</span>
      </article>
    </section>
    <p id="score-meta" class="score-meta">Loading the tally…</p>
    <p class="source">
      Self-reported and unverified. Not an official vote and not a solicitation.
      <a href="/methodology/">How the numbers are made</a>.
    </p>

    <section class="chart-card" aria-labelledby="chart-heading">
      <h2 id="chart-heading">Sentiment</h2>
      <div id="sentiment-chart" class="chart"></div>
      <p id="chart-note" class="source">Retail is the share of For versus For plus Against. The other lines are defined on the methodology page.</p>
    </section>

    <nav class="jump" aria-label="More on this site">
      <a href="/the-vote/">The vote</a>
      <a href="/how-to-vote/">How to cast a ballot</a>
      <a href="/retail-voting-program/">Retail voting program</a>
      <a href="/holders/">Who holds TSLA</a>
      <a href="/voting-history/">Past votes</a>
      <a href="/sentiment/">Full chart</a>
    </nav>
  </div>
</Base>

<script>
  import { mountDashboard } from "../scripts/dashboard";
  mountDashboard(true);
</script>
